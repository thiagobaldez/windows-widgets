<UserControl x:Class="Widgets.Weather.Views.WeatherViewMedium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Widgets.Weather.Views"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary Source="WeatherTheme.xaml" />
    </UserControl.Resources>

    <Border CornerRadius="14"
            Background="{StaticResource CardFill}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Padding="16,14,16,13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sobrancelha: onde a leitura foi feita.
                 Colunas de verdade em vez de dois filhos alinhados no mesmo
                 espaço: assim o selo nunca cobre o nome da cidade. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderLocation"
                           Grid.Column="0"
                           Text="{Binding LocationName}"
                           Style="{StaticResource MicroLabel}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" />
                <Border x:Name="HeaderBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource Mercury}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,0,5,1"
                        Visibility="{Binding ShowsStaleBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StaleBadge}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Mercury}" />
                </Border>
            </Grid>

            <!-- Leitura principal à esquerda, medições secundárias à direita.
                 A temperatura é o que se lê de relance; umidade e vento são
                 consulta, e ficam fora do caminho dela. -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <views:WeatherIcon Grid.Column="0"
                                   Width="52" Height="52"
                                   VerticalAlignment="Center"
                                   Kind="{Binding Icon.Kind}"
                                   IsDay="{Binding Icon.IsDay}"
                                   PrimaryBrush="{StaticResource Ink}"
                                   AccentBrush="{StaticResource Sun}" />

                <StackPanel x:Name="MainReading"
                            Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TemperatureValue}"
                                   Style="{StaticResource Reading}"
                                   FontSize="42"
                                   FontWeight="Light"
                                   LineHeight="44"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding TemperatureUnit}"
                                   Style="{StaticResource Reading}"
                                   FontSize="16"
                                   Foreground="{StaticResource InkDim}"
                                   VerticalAlignment="Top"
                                   Margin="3,6,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               FontSize="13"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ApparentTemperature}"
                               FontSize="11"
                               Foreground="{StaticResource InkDim}"
                               Margin="0,1,0,0" />
                </StackPanel>

                <Grid x:Name="Metrics"
                      Grid.Column="2"
                      Margin="10,2,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="UMIDADE" Style="{StaticResource MicroLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Humidity}"
                               Style="{StaticResource Reading}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="VENTO" Style="{StaticResource MicroLabel}"
                               Margin="0,4,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="8,4,0,0">
                        <TextBlock Text="{Binding WindValue}"
                                   Style="{StaticResource Reading}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding WindUnit}"
                                   FontSize="10"
                                   Foreground="{StaticResource InkDim}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Faixa de hoje: onde a temperatura atual cai entre a mínima e a
                 máxima previstas. Um número sozinho não conta essa história. -->
            <StackPanel Grid.Row="2"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasTodayRange, Converter={StaticResource BoolToVisibility}}">
                <Grid Height="16">
                    <Border Height="3" VerticalAlignment="Center" CornerRadius="1.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#6FB6D9" />
                                <GradientStop Offset="1" Color="#E8623A" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding RangeLeft}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{Binding RangeRight}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1"
                                Width="3" Height="13"
                                CornerRadius="1.5"
                                Background="{StaticResource Ink}" />
                    </Grid>
                </Grid>
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="{Binding TodayMin}"
                               Style="{StaticResource Reading}"
                               FontSize="10"
                               Foreground="{StaticResource Frost}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="hoje"
                               Style="{StaticResource MicroLabel}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TodayMax}"
                               Style="{StaticResource Reading}"
                               FontSize="10"
                               Foreground="{StaticResource Mercury}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Próximos dias -->
            <ItemsControl Grid.Row="3" Margin="0,14,0,0" ItemsSource="{Binding Daily}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" Margin="2,0">
                            <TextBlock Text="{Binding Weekday}"
                                       Style="{StaticResource MicroLabel}"
                                       HorizontalAlignment="Center" />
                            <views:WeatherIcon Width="22" Height="22"
                                               Margin="0,5"
                                               Kind="{Binding Icon}"
                                               PrimaryBrush="{StaticResource Ink}"
                                               AccentBrush="{StaticResource Sun}" />
                            <TextBlock Text="{Binding Max}"
                                       Style="{StaticResource Reading}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Min}"
                                       Style="{StaticResource Reading}"
                                       FontSize="11"
                                       Foreground="{StaticResource InkDim}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rodapé: só o carimbo de hora. Sem as medições, uma linha
                 divisória viraria moldura para um texto apagado sozinho. -->
            <TextBlock x:Name="FooterUpdated"
                       Grid.Row="4"
                       Text="{Binding UpdatedAt}"
                       FontSize="10"
                       Foreground="{StaticResource InkDim}"
                       HorizontalAlignment="Right"
                       Margin="0,12,0,0" />
        </Grid>
    </Border>
</UserControl>
