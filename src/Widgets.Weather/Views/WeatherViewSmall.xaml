<UserControl x:Class="Widgets.Weather.Views.WeatherViewSmall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Widgets.Weather.Views"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary Source="WeatherTheme.xaml" />
    </UserControl.Resources>

    <!-- Só o que se lê num relance: quanto está, como está, e onde. -->
    <Border CornerRadius="12"
            Background="{StaticResource CardFill}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Padding="14,11,14,11">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:WeatherIcon Grid.Column="0"
                               Width="40" Height="40"
                               VerticalAlignment="Center"
                               Kind="{Binding Icon.Kind}"
                               IsDay="{Binding Icon.IsDay}"
                               PrimaryBrush="{StaticResource Ink}"
                               AccentBrush="{StaticResource Sun}" />

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TemperatureValue}"
                               Style="{StaticResource Reading}"
                               FontSize="30"
                               FontWeight="Light"
                               LineHeight="32"
                               LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding TemperatureUnit}"
                               Style="{StaticResource Reading}"
                               FontSize="12"
                               Foreground="{StaticResource InkDim}"
                               VerticalAlignment="Top"
                               Margin="2,4,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding LocationShort}"
                           Style="{StaticResource MicroLabel}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="6,0,0,0"
                    BorderBrush="{StaticResource Mercury}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="4,0,4,1"
                    Visibility="{Binding ShowsStaleBadge, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="!" FontSize="9" FontWeight="Bold"
                           Foreground="{StaticResource Mercury}"
                           ToolTip="{Binding StaleBadge}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
