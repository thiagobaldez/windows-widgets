<UserControl x:Class="Widgets.Weather.Views.WeatherViewLarge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Widgets.Weather.Views"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary Source="WeatherTheme.xaml" />
    </UserControl.Resources>

    <Border CornerRadius="16"
            Background="{StaticResource CardFill}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Padding="20,17,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sobrancelha. Colunas de verdade: o selo nunca cobre a cidade. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding LocationName}"
                           Style="{StaticResource MicroLabel}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" />
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource Mercury}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,0,6,1"
                        Visibility="{Binding ShowsStaleBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StaleBadge}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Mercury}" />
                </Border>
            </Grid>

            <!-- Leitura principal à esquerda, painel de medições à direita.
                 A temperatura é o que se lê de relance; umidade, vento e sol
                 são consulta, e ficam fora do caminho dela. -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <views:WeatherIcon Grid.Column="0"
                                   Width="66" Height="66"
                                   VerticalAlignment="Center"
                                   Kind="{Binding Icon.Kind}"
                                   IsDay="{Binding Icon.IsDay}"
                                   PrimaryBrush="{StaticResource Ink}"
                                   AccentBrush="{StaticResource Sun}" />

                <StackPanel x:Name="MainReading"
                            Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TemperatureValue}"
                                   Style="{StaticResource Reading}"
                                   FontSize="54"
                                   FontWeight="Light"
                                   LineHeight="56"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding TemperatureUnit}"
                                   Style="{StaticResource Reading}"
                                   FontSize="19"
                                   Foreground="{StaticResource InkDim}"
                                   VerticalAlignment="Top"
                                   Margin="4,8,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               FontSize="15"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ApparentTemperature}"
                               FontSize="12"
                               Foreground="{StaticResource InkDim}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Grid x:Name="Metrics"
                      Grid.Column="2"
                      Margin="14,2,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="UMIDADE" Style="{StaticResource MicroLabel}" FontSize="11" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Humidity}"
                               Style="{StaticResource Reading}"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               Margin="10,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="VENTO" Style="{StaticResource MicroLabel}" FontSize="11"
                               Margin="0,5,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="10,5,0,0">
                        <TextBlock Text="{Binding WindValue}"
                                   Style="{StaticResource Reading}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding WindUnit}"
                                   FontSize="11"
                                   Foreground="{StaticResource InkDim}"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0" />
                    </StackPanel>

                    <!-- Some junto quando a API não traz os horários do sol. -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="NASCER" Style="{StaticResource MicroLabel}" FontSize="11"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasSunTimes, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Sunrise}"
                               Style="{StaticResource Reading}"
                               FontSize="12"
                               Foreground="{StaticResource Sun}"
                               HorizontalAlignment="Right"
                               Margin="10,5,0,0"
                               Visibility="{Binding HasSunTimes, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="PÔR" Style="{StaticResource MicroLabel}" FontSize="11"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasSunTimes, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding Sunset}"
                               Style="{StaticResource Reading}"
                               FontSize="12"
                               Foreground="{StaticResource Sun}"
                               HorizontalAlignment="Right"
                               Margin="10,5,0,0"
                               Visibility="{Binding HasSunTimes, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>

            <!-- Faixa de hoje -->
            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        Visibility="{Binding HasTodayRange, Converter={StaticResource BoolToVisibility}}">
                <Grid Height="18">
                    <Border Height="4" VerticalAlignment="Center" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#6FB6D9" />
                                <GradientStop Offset="1" Color="#E8623A" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding RangeLeft}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{Binding RangeRight}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1"
                                Width="4" Height="15"
                                CornerRadius="2"
                                Background="{StaticResource Ink}" />
                    </Grid>
                </Grid>
                <Grid Margin="0,3,0,0">
                    <TextBlock Text="{Binding TodayMin}"
                               Style="{StaticResource Reading}"
                               FontSize="11"
                               Foreground="{StaticResource Frost}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="hoje"
                               Style="{StaticResource MicroLabel}"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TodayMax}"
                               Style="{StaticResource Reading}"
                               FontSize="11"
                               Foreground="{StaticResource Mercury}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Seis dias, com probabilidade de chuva -->
            <ItemsControl Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding DailyExtended}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" Margin="2,0">
                            <TextBlock Text="{Binding Weekday}"
                                       Style="{StaticResource MicroLabel}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                            <views:WeatherIcon Width="26" Height="26"
                                               Margin="0,6"
                                               Kind="{Binding Icon}"
                                               PrimaryBrush="{StaticResource Ink}"
                                               AccentBrush="{StaticResource Sun}" />
                            <TextBlock Text="{Binding Max}"
                                       Style="{StaticResource Reading}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Min}"
                                       Style="{StaticResource Reading}"
                                       FontSize="12"
                                       Foreground="{StaticResource InkDim}"
                                       HorizontalAlignment="Center" />
                            <!-- Some quando a API não sabe. Um "0%" falso
                                 afirmaria o que ninguém afirmou. -->
                            <TextBlock Text="{Binding Precipitation}"
                                       Style="{StaticResource Reading}"
                                       FontSize="11"
                                       Foreground="{StaticResource Frost}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasPrecipitation,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rodapé: só o carimbo de hora. As medições subiram para o
                 painel do canto superior direito. -->
            <TextBlock x:Name="FooterUpdated"
                       Grid.Row="4"
                       Text="{Binding UpdatedAt}"
                       FontSize="10"
                       Foreground="{StaticResource InkDim}"
                       HorizontalAlignment="Right"
                       Margin="0,14,0,0" />
        </Grid>
    </Border>
</UserControl>
